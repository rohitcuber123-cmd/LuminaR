# Core library backend
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=luminar_library
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Optional email delivery (leave unset to disable email sending)
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=library@example.org
BREVO_SENDER_NAME=LuminaR

# Optional encrypted private document cache (disabled by default)
KNOW_MORE_DEVICE_CACHE_ENABLED=false
KNOW_MORE_CACHE_MASTER_KEY=
KNOW_MORE_CACHE_KEY_VERSION=1
