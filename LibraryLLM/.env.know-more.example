# Server-only: generate once with python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Save privately in .env; never use a VITE_ prefix or commit the value.
KNOW_MORE_DEVICE_CACHE_ENABLED=false
KNOW_MORE_CACHE_MASTER_KEY=
KNOW_MORE_CACHE_KEY_VERSION=1
KNOW_MORE_CACHE_MAX_BUNDLE_BYTES=67108864
# Browser limits can be overridden in frontend/.env.local (restart Vite).
# VITE_KNOW_MORE_LOCAL_CACHE_MAX_DOCS=10
# VITE_KNOW_MORE_LOCAL_CACHE_MAX_BYTES=134217728
