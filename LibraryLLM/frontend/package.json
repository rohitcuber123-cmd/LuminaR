{
  "name": "luminar-library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:read-now": "node --experimental-strip-types --test tests/read-now.test.ts",
    "test:routing": "node --experimental-strip-types --test tests/general-user-routing.test.ts",
    "test": "node --experimental-strip-types --test tests/read-now.test.ts tests/general-user-routing.test.ts && npm run test:assistant && npm run test:knowledge",
    "test:knowledge": "tsx --tsconfig tsconfig.app.json --test tests/knowledge-artifacts.test.tsx",
    "preview": "vite preview",
    "test:assistant": "tsx --tsconfig tsconfig.app.json --test tests/assistant.test.tsx"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "^4.13.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
