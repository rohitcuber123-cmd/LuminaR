    "         elif not context.seed_work_ids:",
    "-            # Look ahead by one, without changing the existing formula/diversity.",
    "-            filtered = context.filters.model_dump() != Filters().model_dump()",
    "-            depth = 50 if filtered else min(50, offset + context.page_size + 1)",
    "-            if context.candidate_depth < depth and not context.exhausted or context.candidate_depth == 0:",
    "-                ranking = await tools.recommendation.recommend(depth)",
    "-                context.candidate_work_ids = list(dict.fromkeys(context.candidate_work_ids + ranking))[:50]",
    "-                context.candidate_depth = depth",
    "-                context.exhausted = depth == 50 or len(ranking) < depth",
    "+            # Retain one deeper ordered pool; SHOW_MORE never recomputes prefixes.",
    "+            if not context.candidate_work_ids and not continuing:",
    "+                context.candidate_work_ids = await tools.recommendation.recommend(50)",
    "+                context.candidate_depth, context.exhausted = 50, True",
