      "diff": "--- scratch\\search_proof_recovery_v7r1\\parser.py\n\n+++ scratch\\search_proof_recovery_v8\\parser.py\n\n@@ -16,7 +16,7 @@\n\n from .source_roles import partition,annotate,records,Modality,Role\n from .surface import claim_preferences,claim_frames,semantic_projection,generic_topic,CONSERVATIVE,residual_segments\n \n-PARSER_VERSION='search-smarteng-disabled-proof-7r1'\n+PARSER_VERSION='search-smarteng-disabled-proof-8'\n QueryPlan=native.QueryPlan\n normalize=native.normalize\n matches=native.matches\n@@ -187,6 +187,13 @@\n\n             if supplied and (status=='INCOMPLETE' or all(re.search(r'[\"\u201c].+[\"\u201d]',r.source_text) for r in supplied)) and not re.search(r'\\b(?:slot|operand|blank|empty|left\\s+open)\\b|\\[|\\.{3}|\u2026',outside(raw[a:b]),re.I):continue\n \n         if a>=b:continue\n+        # Legacy inventory may include terminal punctuation outside the lexical\n+        # clause. It cannot relabel a fully specified unsupported record join\n+        # as an unresolved author operand merely because that dot is unowned.\n+        if any(r.state==State.UNSUPPORTED and r.field=='relationship'\n+               and r.provenance.get('recognizer','').startswith('lexical.record_')\n+               and r.source_span[0]<=a and not raw[r.source_span[1]:b].strip(' .!?\\t\\r\\n')\n+               for r in requirements):continue\n         ta=a;tb=b\n         while ta<tb and raw[ta].isspace():ta+=1\n         while tb>ta and raw[tb-1].isspace():tb-=1"
